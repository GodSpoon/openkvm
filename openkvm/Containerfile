# Stage 1: Build
FROM docker.io/golang:1.23-alpine AS builder

WORKDIR /build

# Install build dependencies
RUN apk add --no-cache \
  gcc \
  musl-dev \
  linux-headers \
  v4l-utils-dev

# Copy source
COPY . .

# Build binary (CGO disabled for static binary)
RUN CGO_ENABLED=0 GOOS=linux GOARCH=$(go env GOARCH) \
  go build -trimpath -o openkvm .

# Stage 2: Runtime
FROM alpine:3.19

RUN apk add --no-cache \
  ffmpeg \
  v4l-utils \
  libstdc++ \
  zlib

WORKDIR /app

# Copy binary from builder
COPY --from=builder /build/openkvm .

# Copy UI files
COPY ui/ ./ui/

# Expose port
EXPOSE 8080

CMD ["./openkvm"]
